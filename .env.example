# ---------------------------------------------------------------------------
# Shoply environment variables
# Copy this file to .env.local and fill in the values for your setup.
# NEVER commit real credentials. .env.local is gitignored.
# ---------------------------------------------------------------------------

# AWS region for DynamoDB (used for both local and real AWS).
AWS_REGION=us-east-1

# Optional: point the app at a local DynamoDB instance.
# - Set this to use DynamoDB Local (e.g. http://localhost:8000).
# - Leave it UNSET/empty to use real AWS DynamoDB via the standard credential chain.
DYNAMODB_ENDPOINT=http://localhost:8000

# AWS credentials.
# - For DynamoDB Local, any dummy values work (the app also falls back to dummies).
# - For real AWS, use real credentials OR omit these and rely on the AWS
#   credential chain (shared config, IAM role, etc.).
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Prefix applied to every DynamoDB table name (lets you namespace environments).
DYNAMODB_TABLE_PREFIX=Shoply_
